# Example configuration for link-organizer-api.
# bin/startup.sh reads /etc/app-configs/link-mgmnt/.env (override with ENV_FILE).
# `npm run dev` reads ./.env — copy this file there for local development.

# --- HTTP server ---
HOST=127.0.0.1
PORT=3000
# Comma-separated origins allowed by CORS; "*" allows any. Default matches the Vite dev server.
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:5174,http://localhost:5174

# --- Database (MariaDB) ---
# "mariadb" or "mysql"
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=link_mgmnt
DB_USERNAME=link_mgmnt
DB_PASSWORD=change-me

# Apply pending migrations at startup.
DB_MIGRATIONS_RUN=true
# Auto-sync the schema to the entities. Development only — can drop data.
DB_SYNCHRONIZE=false
# Log every SQL statement.
DB_LOGGING=false
